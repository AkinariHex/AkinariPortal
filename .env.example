# ---- Supabase ----
# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key. SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# (Renamed from the old, leaked NEXT_PUBLIC_SUPABASE_SECRET_KEY — rotate it.)
SUPABASE_SERVICE_ROLE_KEY=

# ---- osu! OAuth ----
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ---- Twitch ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Secret guarding the internal /api/twitch/generate endpoint (fail-closed).
TWITCH_GENERATE_SECRET=

# ---- NextAuth ----
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# Public base URL used for client-side share links.
NEXT_PUBLIC_NEXTAUTH_URL=

# ---- ISR on-demand revalidation ----
REVALIDATE_SECRET=
