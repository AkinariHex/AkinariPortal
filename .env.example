# Copy to `.env` (or `.env.local`) and fill in. Never commit the filled file.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.

# ---- Supabase ----
# Project URL (public, safe in the browser). Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key. SECRET, SERVER-ONLY. Never add a NEXT_PUBLIC_ prefix to this.
# Supabase dashboard > Project Settings > API > service_role. Rotate the old leaked one.
SUPABASE_SERVICE_ROLE_KEY=

# ---- osu! OAuth (login) ----
# Create at https://osu.ppy.sh/home/account/edit > OAuth > New OAuth Application.
# Callback URL must be <your-site>/api/auth/callback/osu
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ---- Twitch (livestream check + extension) ----
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Your own secret guarding the internal /api/twitch/generate endpoint (fail-closed:
# the endpoint is disabled unless this is set). Any long random string.
TWITCH_GENERATE_SECRET=

# ---- NextAuth / Auth.js v5 ----
# Session encryption secret. REQUIRED. Generate: `openssl rand -base64 32`
# (Auth.js v5 also accepts AUTH_SECRET; NEXTAUTH_SECRET is used here.)
NEXTAUTH_SECRET=
# Canonical site URL used for OAuth callbacks, e.g. http://localhost:3000 in dev,
# https://akinariportal.vercel.app in prod.
NEXTAUTH_URL=
# Same base URL, but exposed to the browser for client-side share links.
NEXT_PUBLIC_NEXTAUTH_URL=

# ---- On-demand ISR revalidation ----
# Your own secret guarding GET /api/revalidate?secret=... Any long random string.
REVALIDATE_SECRET=
